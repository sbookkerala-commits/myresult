# Render / production environment (set these in Render Dashboard → Environment)

NODE_ENV=production
PORT=10000
HOST=0.0.0.0

# Required
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/DB?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
USE_EMBEDDED_MONGO=false

# Memory / crash protection (recommended for Starter / Free)
# Do NOT enable SERVE_STATIC_WEB on a 512MB plan if API + Flutter web share one service.
SERVE_STATIC_WEB=false
JSON_BODY_LIMIT=2mb
API_LIST_LIMIT=2000
API_MAX_LIST_LIMIT=5000
RESTORE_BOOKING_LIMIT=3000
RESTORE_SALE_LIMIT=5000
RESTORE_CHART_LIMIT=1000
BACKUP_BATCH_SIZE=500
BACKUP_MAX_DOCS=10000
MONGO_MAX_POOL=5
MEMORY_LOG_MS=300000
RETENTION_DAYS=20
EXIT_ON_UNCAUGHT=false

# Optional: if you must serve Flutter web from this same service, upgrade RAM
# and set SERVE_STATIC_WEB=true
